# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage
.coverage
.coverage.*
htmlcov/

# Distribution / packaging
*.egg-info/
*.egg
dist/
build/
wheels/

# uv (library: resolve from pyproject, no committed lockfile)
uv.lock

# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# PyTorch / ML artifacts
*.pt
*.pth
*.ckpt
*.safetensors

# Data (downloaded on demand)
data/

# Profiling
*.trace.json
profile_traces/

# Stale run logs
logs/
*.log

# Editor / tooling backups
*.bak

# Example outputs (regeneratable; keep the directory via .gitkeep)
examples/figures/*.png
examples/figures/*.gif
!examples/figures/.gitkeep

# scratch dir for local verification runs
.tmp/

# Run outputs (regenerated by the runners; see docs/reproducibility.md)
experiments/results/

# Third-party SLS solver binary, built locally (see docs/reproducibility.md)
experiments/scripts/probsat
